<Window x:Class="LyricsStatus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyricat" Width="980" Height="640" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" WindowStyle="None"
        Background="{StaticResource WindowBg}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource RailBg}" MouseLeftButtonDown="DragArea_MouseDown">
            <Grid>
            <Canvas IsHitTestVisible="False" Opacity="0.07">
                <Path Style="{StaticResource PawPrint}" Width="26" Canvas.Left="34" Canvas.Top="540"><Path.RenderTransform><RotateTransform Angle="-18" /></Path.RenderTransform></Path>
                <Path Style="{StaticResource PawPrint}" Width="26" Canvas.Left="74" Canvas.Top="498"><Path.RenderTransform><RotateTransform Angle="12" /></Path.RenderTransform></Path>
                <Path Style="{StaticResource PawPrint}" Width="26" Canvas.Left="44" Canvas.Top="448"><Path.RenderTransform><RotateTransform Angle="-14" /></Path.RenderTransform></Path>
                <Path Style="{StaticResource PawPrint}" Width="26" Canvas.Left="86" Canvas.Top="404"><Path.RenderTransform><RotateTransform Angle="16" /></Path.RenderTransform></Path>
                <Path Style="{StaticResource PawPrint}" Width="40" Canvas.Left="168" Canvas.Top="300"><Path.RenderTransform><RotateTransform Angle="24" /></Path.RenderTransform></Path>
            </Canvas>
            <DockPanel Margin="18,22,18,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,28">
                    <Image Source="/Assets/icon.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Lyricat" FontFamily="{StaticResource DisplayFont}" FontSize="21" Margin="12,0,0,0"
                               FontWeight="SemiBold" Foreground="{StaticResource Deep}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="ShareToggle" Style="{StaticResource ShareButton}" Click="ShareToggle_Click"
                            Margin="0,0,0,14" ToolTip="Turn lyric sharing on or off">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ShareDot" Width="9" Height="9" Fill="{StaticResource Faint}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="ShareText" Grid.Column="1" Text="Not sharing" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}" Margin="10,0,8,0" VerticalAlignment="Center" />
                            <Border x:Name="ShareTrack" Grid.Column="2" Width="38" Height="22" CornerRadius="11"
                                    Background="#4A3F72" VerticalAlignment="Center">
                                <Ellipse x:Name="ShareKnob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left"
                                         Margin="3,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ShareKnobMove" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"
                            Click="Update_Click" Margin="0,0,0,12" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock x:Name="UpdateText" Text="Update available" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="VersionText" Text="v2.0.0" FontSize="11" Foreground="{StaticResource Faint}" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavNow" Style="{StaticResource NavButton}" Tag="&#xE8D6;" Content="Now playing"
                                 GroupName="Nav" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAccounts" Style="{StaticResource NavButton}" Tag="&#xE77B;" Content="Accounts"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                 GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" Tag="&#xE946;" Content="About"
                                 GroupName="Nav" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Canvas Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.05">
                <Path Style="{StaticResource PawPrint}" Width="34" Canvas.Left="610" Canvas.Top="560"><Path.RenderTransform><RotateTransform Angle="-20" /></Path.RenderTransform></Path>
                <Path Style="{StaticResource PawPrint}" Width="26" Canvas.Left="660" Canvas.Top="520"><Path.RenderTransform><RotateTransform Angle="10" /></Path.RenderTransform></Path>
                <Path Style="{StaticResource PawPrint}" Width="22" Canvas.Left="440" Canvas.Top="20"><Path.RenderTransform><RotateTransform Angle="30" /></Path.RenderTransform></Path>
                <Path Style="{StaticResource PawPrint}" Width="18" Canvas.Left="12" Canvas.Top="300"><Path.RenderTransform><RotateTransform Angle="-35" /></Path.RenderTransform></Path>
            </Canvas>

            <Grid Background="Transparent" MouseLeftButtonDown="DragArea_MouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,8,0" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>

            <Grid x:Name="PageNow" Grid.Row="1" Margin="32,0,32,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Now playing" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Your lyrics, live in your Discord status." Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <Border Grid.Row="1" Margin="0,32,0,0" CornerRadius="24" Background="{StaticResource Hero}"
                        BorderBrush="#9D6CF0" BorderThickness="1.5" Padding="20" Effect="{StaticResource GlowShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Width="104" Height="104" CornerRadius="16" Background="#33FFFFFF">
                            <Grid>
                                <TextBlock x:Name="CoverPlaceholder" Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="34"
                                           Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                                <Border x:Name="Cover" CornerRadius="16" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="22,4,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SongTitle" Text="Nothing playing yet" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="24" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SongArtist" Text="Press Start, then play something on Spotify" FontSize="14"
                                       Foreground="#DDFFFFFF" TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TimeNow" Text="0:00" FontSize="11" Foreground="#DDFFFFFF" Width="34" />
                                <Grid Grid.Column="1" Height="6" VerticalAlignment="Center" Margin="6,0">
                                    <Border CornerRadius="3" Background="#40FFFFFF" />
                                    <Border x:Name="ProgressFill" CornerRadius="3" Background="White" HorizontalAlignment="Left"
                                            RenderTransformOrigin="0,0.5" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="TimeTotal" Grid.Column="2" Text="0:00" FontSize="11" Foreground="#DDFFFFFF"
                                           Width="34" TextAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Image x:Name="Mascot" Grid.Row="1" Source="/Assets/ninu-peek.png" Width="176" Panel.ZIndex="2"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-91,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="MascotFlip" ScaleX="-1" />
                    </Image.RenderTransform>
                </Image>

                <Grid x:Name="DracaniRig" Grid.Row="1" Width="186" Panel.ZIndex="2" Visibility="Collapsed"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-86,16,0" IsHitTestVisible="False"
                      RenderOptions.BitmapScalingMode="HighQuality">
                    <Grid RenderTransformOrigin="0.5,0.85">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="HeadTilt" />
                                <TranslateTransform x:Name="HeadBob" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Image Source="/Assets/dracani/back.png" />
                        <Image Source="/Assets/dracani/earB.png" RenderTransformOrigin="0.384,0.600">
                            <Image.RenderTransform><RotateTransform x:Name="EarBTurn" /></Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/dracani/mid.png" />
                        <Image Source="/Assets/dracani/earA.png" RenderTransformOrigin="0.705,0.719">
                            <Image.RenderTransform><RotateTransform x:Name="EarATurn" /></Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/dracani/front.png" />
                    </Grid>
                    <Image Source="/Assets/dracani/pawL.png">
                        <Image.RenderTransform><TranslateTransform x:Name="PawLUp" /></Image.RenderTransform>
                    </Image>
                    <Image Source="/Assets/dracani/pawR.png">
                        <Image.RenderTransform><TranslateTransform x:Name="PawRUp" /></Image.RenderTransform>
                    </Image>
                </Grid>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="LYRICS" Style="{StaticResource Caption}" />
                            <Canvas x:Name="LyricsCanvas" Grid.Row="1" Height="176" VerticalAlignment="Center"
                                    ClipToBounds="True" Margin="0,6,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="THE SONG" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="♥" FontSize="13" Foreground="{StaticResource Dangerous}" VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.55" Margin="0,0,6,0">
                                            <TextBlock.RenderTransform><ScaleTransform x:Name="HeartBeat" /></TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock x:Name="BpmText" Text="— BPM" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="19" />
                                        <RowDefinition Height="19" />
                                        <RowDefinition Height="19" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Energy" Style="{StaticResource VibeLabel}" />
                                    <Border Grid.Column="1" Style="{StaticResource VibeTrack}">
                                        <Border Style="{StaticResource VibeFill}">
                                            <Border.RenderTransform><ScaleTransform x:Name="EnergyFill" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Border>
                                    <TextBlock x:Name="EnergyValue" Grid.Column="2" Style="{StaticResource VibeValue}" />

                                    <TextBlock Grid.Row="1" Text="Danceability" Style="{StaticResource VibeLabel}" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource VibeTrack}">
                                        <Border Style="{StaticResource VibeFill}">
                                            <Border.RenderTransform><ScaleTransform x:Name="DanceFill" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Border>
                                    <TextBlock x:Name="DanceValue" Grid.Row="1" Grid.Column="2" Style="{StaticResource VibeValue}" />

                                    <TextBlock Grid.Row="2" Text="Speechiness" Style="{StaticResource VibeLabel}" />
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource VibeTrack}">
                                        <Border Style="{StaticResource VibeFill}">
                                            <Border.RenderTransform><ScaleTransform x:Name="SpeechFill" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Border>
                                    <TextBlock x:Name="SpeechValue" Grid.Row="2" Grid.Column="2" Style="{StaticResource VibeValue}" />
                                </Grid>
                            </StackPanel>

                        <StackPanel>
                            <TextBlock Text="ON DISCORD" Style="{StaticResource Caption}" />
                            <Border Margin="0,10,0,0" CornerRadius="16" Background="#1E1F22" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="38" Height="38">
                                            <Ellipse Fill="#4E5058" />
                                            <Ellipse x:Name="Avatar" />
                                            <Ellipse Width="12" Height="12" Fill="#23A55A" Stroke="#1E1F22" StrokeThickness="2.5"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="DiscordName" Text="You" FontWeight="SemiBold" FontSize="14" Foreground="White" />
                                            <TextBlock x:Name="DiscordUser" Text="not connected yet" FontSize="12" Foreground="#B5BAC1" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Margin="0,10,0,0" CornerRadius="10" Background="#2B2D31" Padding="10,7">
                                        <TextBlock x:Name="DiscordStatus" Text="Your status will show up here" FontSize="13"
                                                   Foreground="#DBDEE1" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="StatsText" Grid.Row="3" Margin="4,14,0,0" FontSize="12"
                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           Text="Changes during this session: 0" />
            </Grid>

            <ScrollViewer x:Name="PageAccounts" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,0,32,26">
                    <TextBlock Text="Accounts" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Stored encrypted in Windows Credential Manager and only ever sent to Discord and Spotify. Hover the ? to see where to find each one." />
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <UniformGrid x:Name="SecretFields" Columns="2" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Click="SaveAccounts_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0" />
                                <TextBlock Text="Save &amp; check" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButton}" Click="OpenDashboard_Click" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" Foreground="{StaticResource Deep}" Margin="0,0,8,0" />
                                <TextBlock Text="Open Spotify dashboard" Foreground="{StaticResource Deep}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButton}" Click="CopyRedirect_Click" Margin="10,0,0,0"
                                ToolTip="http://127.0.0.1:8888/callback">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Foreground="{StaticResource Deep}" Margin="0,0,8,0" />
                                <TextBlock Text="Copy redirect URI" Foreground="{StaticResource Deep}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="AccountsResult" Style="{StaticResource Hint}" Margin="2,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,0,32,26">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Changes save and apply right away." Style="{StaticResource PageSubtitle}" />

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Border x:Name="RiskChip" DockPanel.Dock="Right" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="RiskIcon" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock x:Name="RiskText" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Lyrics update speed" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="How often your Discord status can change." Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SpeedSlider" Style="{StaticResource CozySlider}" Minimum="1" Maximum="10"
                                        TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="1"
                                        Foreground="{StaticResource Primary}" ValueChanged="SpeedSlider_ValueChanged" />
                                <TextBlock x:Name="SpeedValue" Grid.Column="1" Text="4.0 s" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Deep}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,2,90,0">
                                <TextBlock Text="Faster" FontSize="11" Foreground="{StaticResource Faint}" />
                                <TextBlock Text="Slower" FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock x:Name="RiskExplain" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="What your status shows" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,14"
                                       Text="You can use {line} (the lyric), {title} and {artist}." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Status format" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="FormatBox" TextChanged="Setting_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Emoji" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="EmojiBox" TextChanged="Setting_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                    <TextBlock Text="When a song has no lyrics" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="NoLyricsBox" TextChanged="Setting_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                    <TextBlock Text="Instrumental parts" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="PauseBox" TextChanged="Setting_Changed" />
                                    <TextBlock Text="Leave it empty for a blank status." Style="{StaticResource Hint}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                    <TextBlock Text="When Spotify is paused" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="PausedBox" TextChanged="Setting_Changed" />
                                    <TextBlock Text="Leave it empty to bring your normal status back while paused." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Fine-tuning" FontSize="15" FontWeight="SemiBold" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Lyrics offset" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Lyrics late? Move it right." FontSize="11" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                                <Slider x:Name="OffsetSlider" Grid.Column="1" Style="{StaticResource CozySlider}" Minimum="-3" Maximum="3"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="0.5"
                                        Foreground="{StaticResource Primary}" ValueChanged="OffsetSlider_ValueChanged" />
                                <TextBlock x:Name="OffsetValue" Grid.Column="2" Text="+0.3 s" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Deep}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,16" />
                            <CheckBox x:Name="JoinLines" Style="{StaticResource Switch}"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed">
                                <StackPanel>
                                    <TextBlock Text="Show two lines at once" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                               Text="Lines are sent in pairs as a single status, like “line one - line two”. Great for fast songs, and your status changes half as often." />
                                </StackPanel>
                            </CheckBox>
                            <Grid x:Name="SeparatorRow" Margin="0,10,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Separator" FontSize="12" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox x:Name="SeparatorBox" Grid.Column="1" MaxLength="5" TextAlignment="Center"
                                         TextChanged="Setting_Changed" />
                                <TextBlock x:Name="SeparatorPreview" Grid.Column="2" FontSize="12" Foreground="{StaticResource Faint}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <CheckBox x:Name="StopOn429" Style="{StaticResource Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed">
                                <StackPanel>
                                    <TextBlock Text="Stop if Discord rate-limits me" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Safer: stops at the first 429 instead of waiting and retrying." FontSize="11" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="CheckUpdates" Style="{StaticResource Switch}" Margin="0,14,0,0"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed">
                                <StackPanel>
                                    <TextBlock Text="Check for updates on startup" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Only checks. Nothing installs without your click." FontSize="11" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Misc" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Who peeks over the Now playing card" Style="{StaticResource FieldLabel}" Margin="0,14,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="MascotConcept" GroupName="Mascot" Style="{StaticResource ChoiceChip}"
                                             Content="Ninu Concept" Checked="Setting_Changed" />
                                <RadioButton x:Name="MascotDracani" GroupName="Mascot" Style="{StaticResource ChoiceChip}"
                                             Content="Ninu by Dracani" Checked="Setting_Changed" Margin="8,0,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="EarsDance" Style="{StaticResource Switch}" Margin="0,16,0,0"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed">
                                <StackPanel>
                                    <TextBlock Text="Ninu dances to the music" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                               Text="Ninu by Dracani only. Her ears follow the beat, and with high-energy songs her head and paws join in. Listens to what your PC is playing to find the beat; nothing is recorded or saved." />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="ReduceMotion" Style="{StaticResource Switch}" Margin="0,14,0,0"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed">
                                <StackPanel>
                                    <TextBlock Text="Reduce motion" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                               Text="The BPM heart stops beating and the song bars stop sliding. Ninu's dance has its own switch above." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                            Content="Reset to defaults" Click="ResetSettings_Click" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PageAbout" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,0,32,26">
                    <TextBlock Text="About" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="A tiny, unofficial side project." Style="{StaticResource PageSubtitle}" />

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock FontSize="14" TextWrapping="Wrap" LineHeight="22"
                                       Text="I was bored, eating cookies, and wondered if this could be done. Long story short: it could, and here it is." />
                            <TextBlock Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Deep}"
                                       Text="Made with lots of love. From Kisu to the world. ^w^" />
                            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Click="OpenKofi_Click" ToolTip="ko-fi.com/panconkisu">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="♥" Margin="0,0,8,0" />
                                    <TextBlock Text="Support me on Ko-fi" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Center"
                                     Stroke="{StaticResource Primary}" StrokeThickness="2">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="pack://application:,,,/Assets/dracani-avatar.png" Stretch="UniformToFill"
                                                RenderOptions.BitmapScalingMode="HighQuality" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Credits" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap" LineHeight="20">
                                    <Run Text="The dancing Ninu (Ninu by Dracani) was drawn by " /><Run Text="Dracani" FontWeight="SemiBold" Foreground="{StaticResource Deep}" /><Run Text=". Thank you so much!!!! " /><Run Text="♥" Foreground="{StaticResource Primary}" FontSize="15" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}">
                                    <Hyperlink Style="{StaticResource Link}" Click="OpenDracani_Click">linktr.ee/Dracani</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Background="#33291F" BorderBrush="#5A4630">
                        <DockPanel>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Questionable}"
                                       VerticalAlignment="Top" Margin="0,2,16,0" />
                            <StackPanel>
                                <TextBlock Text="Disclaimer" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="DisclaimerAbout" Style="{StaticResource Hint}" FontSize="13" Foreground="{StaticResource Text}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Check for updates"
                                    Click="CheckUpdates_Click" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock x:Name="AboutVersion" Text="Lyricat" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Hint}">
                                    <Hyperlink Style="{StaticResource Link}" Click="OpenRepo_Click">Source code on GitHub</Hyperlink>
                                    <Run Text="  ·  MIT License" />
                                </TextBlock>
                                <TextBlock x:Name="UpdateResult" Style="{StaticResource Hint}" />
                                <TextBlock x:Name="AllTimeText" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Activity" FontSize="15" FontWeight="SemiBold" />
                            <TextBox x:Name="LogBox" Margin="0,12,0,0" Height="150" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" Padding="12,10"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                     Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Canvas x:Name="Guides" Grid.Row="1" Panel.ZIndex="5" IsHitTestVisible="False" />

            <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,26"
                    CornerRadius="12" Background="{StaticResource Primary}" Padding="14,9" Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0" />
                    <TextBlock x:Name="ToastText" Text="Saved" Foreground="White" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DisclaimerOverlay" Grid.ColumnSpan="2" Background="#D90E0A1C" Visibility="Collapsed">
            <Border Width="500" CornerRadius="24" Background="{StaticResource Surface}" Padding="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <Image Source="/Assets/icon.png" Width="44" Height="44" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Before you start" Style="{StaticResource PageTitle}" FontSize="22" Margin="0,14,0,0" />
                    <TextBlock x:Name="DisclaimerText" Style="{StaticResource Hint}" FontSize="13" Margin="0,10,0,0"
                               Foreground="{StaticResource Text}" LineHeight="20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Style="{StaticResource SoftButton}" Content="Quit" Click="Close_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Content="I understand, let's go" Click="AcceptDisclaimer_Click"
                                Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
